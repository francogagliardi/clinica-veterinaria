# Copiar este archivo a .env y completar con los datos reales.
# El .env NO se versiona (está en .gitignore): acá no va ninguna clave real.

# --- Base de datos (las usa docker compose para crear el contenedor) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_clave
POSTGRES_DB=veterinaria
POSTGRES_PORT=5433

# --- Cadena que usa la API (mismo usuario/clave/base/puerto que arriba) ---
# Forma: postgresql+asyncpg://USUARIO:CLAVE@HOST:PUERTO/NOMBRE_BASE
DATABASE_URL=postgresql+asyncpg://postgres:cambiar_clave@localhost:5433/veterinaria

# Muestra en consola el SQL que se ejecuta (sirve para contar consultas: caso C-07).
DB_ECHO=true
